# ─────────────────────────────────────────────────────────
# LINKEDIN SCRAPER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# LinkedIn Search Queries: supports BOTH hashtags and natural non-hashtag phrases (e.g. recruiters without tags)
LINKEDIN_SEARCH_QUERIES="#aiml #hiring,#machinelearning #hiring,#genai #hiring,#agenticai #hiring,#aiengineer #hiring,#pythondeveloper #hiring,#datascience #hiring,#mlops #hiring,#llm #hiring,#azuredataengineer #hiring,#aisoftwaredeveloper #hiring,hiring \"Gen AI Engineer\" email,hiring \"Agentic AI\" email,hiring \"AI engineer\" email,we are hiring \"machine learning\" resume,looking for \"Python developer\" email,hiring \"AI Software Developer\" email,hiring \"Data Engineer\" \"Azure\" email,hiring \"Generative AI\" \"send resume\",hiring \"AI/ML\" email,hiring \"LLMs\" \"share your resume\",\"share your resume to\" \"AI\",\"share your updated resume on\" \"Engineer\""
LINKEDIN_HASHTAGS="${LINKEDIN_SEARCH_QUERIES}"

# Scrape filter: 7 = past week, 14 = past 2 weeks, 30 = past month
LINKEDIN_SCRAPE_DAYS=7

# Max posts to scrape per query
MAX_POSTS_PER_SEARCH=100

# Pause time between scrolls (seconds) - avoid detection
SCROLL_PAUSE_TIME=3

# ─── YOUR PROFILE (Used by Ollama to write emails) ───────
YOUR_NAME=Your Full Name
YOUR_ROLE=AI/ML Engineer
YOUR_SKILLS=Python, Machine Learning, Deep Learning, NLP, Generative AI, LLMs, RAG, PyTorch, TensorFlow, FastAPI, Docker, SQL, MongoDB, MLOps, AWS
YOUR_EXPERIENCE=2.5+ years
# Only apply to jobs asking for <= this experience (e.g., 3 means 0-3 years, freshers, etc.)
MAX_TARGET_EXPERIENCE=3
# Match posts containing these domains/skills
TARGET_ROLE_KEYWORDS=machine learning,ai,python,ml,data science,deep learning,nlp,mlops,generative ai,genai,gen ai engineer,llm,artificial intelligence,ai engineer,ml engineer,machine learning engineer,data scientist,ai/ml engineer,deep learning engineer,rag,graphrag,langchain,llamaindex,agentic ai,ai agents,computer vision,natural language processing,pytorch,tensorflow,fastapi,data engineering,data engineer,azure data engineer,python developer,ai software developer,full stack developer,applied scientist,vector database,embeddings,fine-tuning,transformers,huggingface,django,azure
YOUR_MOBILE=+91-XXXXXXXXXX           # Required — shown in every email signature
YOUR_LINKEDIN=
YOUR_GITHUB=
YOUR_PORTFOLIO=                        # Optional — leave blank if none
RESUME_PATH=assets/resume.pdf

# ─── OLLAMA CONFIGURATION ────────────────────────────────
OLLAMA_BASE_URL=http://10.199.207.232:11434
# Available models: gemma, llama3, mistral, phi3
OLLAMA_MODEL=gemma3:12b

# ─── SMTP EMAIL CONFIGURATION ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=3mr.jackal@gmail.com
# Use Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
EMAIL_SUBJECT_PREFIX=Application for

# ─── MONGODB CONFIGURATION ───────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=linkedin_scraper

# Collection names
MONGO_POSTS_COLLECTION=scraped_posts
MONGO_EMAILS_COLLECTION=extracted_emails
MONGO_SENT_COLLECTION=sent_emails
MONGO_RESPONSES_COLLECTION=email_responses

# ─── EMAIL FILTERS & SAFETY LIMITS ───────────────────────
# Skip if already mailed this address within N days
EMAIL_COOLDOWN_DAYS=15

# Max emails to send per run (safety limit)
MAX_EMAILS_PER_DAY=30

# Delay between sending emails (seconds) - avoid spam flags
DELAY_BETWEEN_EMAILS=60

# ─── HEADLESS BROWSER ────────────────────────────────────
# true = run browser in background, false = visible browser
HEADLESS=false

# ─── PIPELINE MODE FLAG ──────────────────────────────────
# SCRAPE_MODE=true  → Full pipeline: scrape LinkedIn → extract → AI email → send
# SCRAPE_MODE=false → Skip scraping: use existing MongoDB email backlog → AI email → send
#                     (faster, no browser needed — great for draining saved leads)
SCRAPE_MODE=false
